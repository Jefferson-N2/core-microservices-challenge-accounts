# 🐳 Core Microservices Challenge - Environment Configuration Example
# Copy this file to .env and modify the values as needed

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
# Desarrollo local
# export SERVER_PORT=8080
# export KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# # Producción
# export SERVER_PORT=80
# export KAFKA_BOOTSTRAP_SERVERS=prod-kafka:9092

ENVIRONMENT=docker
COMPOSE_PROJECT_NAME=core-microservices

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=microservices_db
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_ROOT_PASSWORD=root

# Connection URL
DB_URL=jdbc:mysql://mysql:3306/microservices_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ZOOKEEPER_HOST=zookeeper
ZOOKEEPER_PORT=2181

# Kafka Topics
KAFKA_CUSTOMER_TOPIC=customer.events
KAFKA_CONSUMER_GROUP_ID=accounts-service

# =============================================================================
# MICROSERVICES PORTS
# =============================================================================
CUSTOMERS_SERVICE_PORT=8080
ACCOUNTS_SERVICE_PORT=8081

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_PATTERN=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# =============================================================================
# SPRING BOOT CONFIGURATION
# =============================================================================
SPRING_PROFILES_ACTIVE=docker
SPRING_APPLICATION_NAME_CUSTOMERS=customers-service
SPRING_APPLICATION_NAME_ACCOUNTS=accounts-service
SPRING_KAFKA_CONSUMER_GROUP_ID=accounts-service-v3
SERVER_SERVLET_CONTEXT_PATH=/

# External Services
CUSTOMERS_SERVICE_URL=http://customers-service:8080
CUSTOMERS_SERVICE_TIMEOUT=5000
CUSTOMERS_SERVICE_RETRY=3

# =============================================================================
# ACTUATOR CONFIGURATION
# =============================================================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# =============================================================================
# MICROSERVICES VERSIONS
# =============================================================================
CUSTOMERS_VERSION=1.0.0
ACCOUNTS_VERSION=1.0.0

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
NETWORK_NAME=microservices-network

# =============================================================================
# DEVELOPMENT OVERRIDES (uncomment for local development)
# =============================================================================
# ENVIRONMENT=dev
# DB_HOST=localhost
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# SPRING_PROFILES_ACTIVE=dev

# =============================================================================
# PRODUCTION OVERRIDES (uncomment for production)
# =============================================================================
# ENVIRONMENT=prod
# LOG_LEVEL=WARN
# DB_PASSWORD=your_secure_password_here
# SPRING_PROFILES_ACTIVE=prod